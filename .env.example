# LLM provider
OPENAI_API_KEY=

# Which LLM the agent uses (see backend/agent.py) -- change this line to switch models
AGENT_MODEL=gpt-4o-mini

# Backend
CHROMA_PERSIST_DIR=./backend/chroma_db
UNDERWRITING_EXCEL_PATH=./backend/data/underwriting_criteria.xlsx
POLICY_HTML_DIR=./backend/data/policies

# Comma-separated frontend origin(s) allowed by CORS -- defaults to
# http://localhost:3000 if unset, so local dev needs no configuration.
FRONTEND_ORIGIN=http://localhost:3000

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/decision_assistant

# LLM tracing (optional) -- free LangFuse Cloud account, see https://cloud.langfuse.com
# Leave blank to disable tracing entirely (agent behaves identically either way).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
