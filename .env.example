# LLM provider
OPENAI_API_KEY=

# Which LLM the agent uses (see backend/agent.py) -- change this line to switch models
AGENT_MODEL=gpt-4o-mini

# Backend
CHROMA_PERSIST_DIR=./backend/chroma_db
UNDERWRITING_EXCEL_PATH=./backend/data/underwriting_criteria.xlsx
POLICY_HTML_DIR=./backend/data/policies

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/decision_assistant

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
